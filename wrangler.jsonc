{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "portfolio-v2",
    "compatibility_date": "2026-11-01",
    "compatibility_flags": ["nodejs_compat"],
    "ratelimits": [
        {
            "name": "CONTACT_RATE_LIMIT",
            "namespace_id": "1001",
            "simple": {
                "limit": 5,
                "period": 60,
            },
        },
    ],
}
