{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "portfolio-v2",
    "compatibility_date": "2026-11-01",
    "compatibility_flags": ["nodejs_compat"],
    "workers_dev": true,
    "keep_vars": true,
    "routes": [
        { "pattern": "adithya-rajendran.com", "custom_domain": true },
        { "pattern": "www.adithya-rajendran.com", "custom_domain": true },
    ],
    "observability": {
        "enabled": true,
        "redact_query_string": true,
        "logs": { "enabled": true },
    },
    "ratelimits": [
        {
            "name": "CONTACT_RATE_LIMIT",
            "namespace_id": "1001",
            "simple": {
                "limit": 5,
                "period": 60,
            },
        },
    ],
}
