# Public Sanity identifiers: runtime Worker bindings and Studio build variables.
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Optional server-only token for a private dataset.
SANITY_READ_TOKEN=

# Turnstile public key and exact deployment-specific hostnames.
TURNSTILE_SITE_KEY=
TURNSTILE_HOSTNAMES=
# Store the secret as a Worker secret, not in source control.
TURNSTILE_SECRET=

# Resend credentials and server-only recipient; sender must be verified.
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Optional Google Search Console verification.
GOOGLE_SITE_VERIFICATION=

# CONTACT_RATE_LIMIT is a Worker binding declared in wrangler.jsonc.
