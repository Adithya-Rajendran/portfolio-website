/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload

/studio/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://core.sanity-cdn.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn.sanity.io https://*.sanity.io; font-src 'self' data: https://design-system-static.sanity.io; connect-src 'self' https://*.api.sanity.io https://*.sanity.io wss://*.api.sanity.io; frame-src 'self' https://*.sanity.io; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'

# Cache-Control applies to static assets only: Cloudflare ignores this file for
# Worker-rendered responses (HTML, feeds, API), which set their own headers.
# Keep every rule below disjoint: when several rules match, Cloudflare joins
# duplicate header values with a comma. Never add Cache-Control to /* or
# /studio/* (tests/v2/static-headers.test.ts enforces this).

# Content-hashed build output. The Astro adapter would inject this same rule
# if it were missing; stating it keeps the build from rewriting this file.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Every file below carries a version in its name (-v1, -v2 ...); a changed
# asset is published under a new name, so the old URL never changes content.
/models/*.glb
  Cache-Control: public, max-age=31536000, immutable

/images/scenes/*.webp
  Cache-Control: public, max-age=31536000, immutable

/images/hero-sunrise-v1/*
  Cache-Control: public, max-age=31536000, immutable

/lighting/*
  Cache-Control: public, max-age=31536000, immutable

# The directory name carries the version (jezero-v1); every file inside is
# replaced only by publishing a new directory, never in place.
/terrain/*
  Cache-Control: public, max-age=31536000, immutable

# Mixed directory: some maps are versioned (-v2), earlier ones (earth-1k.webp,
# jupiter-2k.webp, milky-way-band-*.webp ...) are not, and a splat rule cannot
# single out the versioned ones. Revalidate daily, serve stale for a week.
/images/trajectory/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Unversioned names: moderate lifetime so a replaced file still propagates.
/fonts/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/draco/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000
