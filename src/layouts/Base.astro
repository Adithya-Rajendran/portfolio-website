---
import "../styles.css";
import "../styles/journey.css";
import "../styles/space.css";
import { siteConfig } from "../../lib/config";
import { sceneClockBoot } from "../lib/scene-clock";
import { env } from "cloudflare:workers";
const config = env as unknown as Record<string, string | undefined>;
const {
    title = siteConfig.title,
    description = "",
    image = `${siteConfig.url}/share.png`,
    imageAlt = `${siteConfig.author}: projects, writing and experience`,
    pageClass = "",
    structuredData = [],
    ogType = "website",
} = Astro.props;
const currentPath = Astro.url.pathname;
const sharedSky = pageClass !== "experience-page";
const current = (path: string) =>
    currentPath === path || currentPath.startsWith(`${path}/`)
        ? "page"
        : undefined;
const canonical = new URL(Astro.url.pathname, siteConfig.url);
Astro.response.headers.set("Cache-Control", "no-store");
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <script
            is:inline
            nonce={Astro.locals.cspNonce}
            set:html={sceneClockBoot}
        />
        <link
            rel="preload"
            href="/fonts/Manrope-Variable.woff2"
            as="font"
            type="font/woff2"
            crossorigin
        />
        <title>{title === siteConfig.title ? title : `${title} · ${siteConfig.title}`}</title>
        <meta name="description" content={description} />
        {config.GOOGLE_SITE_VERIFICATION && (
            <meta
                name="google-site-verification"
                content={config.GOOGLE_SITE_VERIFICATION}
            />
        )}
        <link rel="canonical" href={canonical} />
        <link
            rel="describedby"
            type="text/plain"
            title="Site guide for agents"
            href="/llms.txt"
        />
        <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Writing RSS"
            href="/feed.xml"
        />
        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={image} />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:image" content={image} />
        <meta name="twitter:image:alt" content={imageAlt} />
        <link rel="icon" href="/icon.svg" />
        {structuredData.map((item: unknown) => (
            <script
                type="application/ld+json"
                nonce={Astro.locals.cspNonce}
                set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
            />
        ))}
    </head>
    <script is:inline nonce={Astro.locals.cspNonce}>
        try {
            const theme = localStorage.getItem("theme");
            if (theme === "light" || theme === "dark")
                document.documentElement.dataset.theme = theme;
        } catch {}
    </script>
    <body
        class:list={{
            "space-site": sharedSky,
            "reading-page": pageClass === "article-page",
        }}
    >
        {sharedSky && <div class="site-cosmos" aria-hidden="true"></div>}
        <a class="skip" href="#main">
            Skip to content
        </a>
        <header>
            <a class="brand" href="/">
                Adithya Rajendran
            </a>
            <nav aria-label="Main navigation">
                <a href="/portfolio" aria-current={current("/portfolio")}>
                    Projects
                </a>
                <a href="/blog" aria-current={current("/blog")}>
                    Writing
                </a>
                <a href="/resume" aria-current={current("/resume")}>
                    Experience
                </a>
                <a href="/about" aria-current={current("/about")}>
                    About
                </a>
                <a href="/contact" aria-current={current("/contact")}>
                    Contact
                </a>
            </nav>
            <button
                type="button"
                id="theme-switch"
                aria-label="Change color theme"
                hidden
            >
                Theme
            </button>
        </header>
        <main id="main" class={pageClass}>
            <slot />
        </main>
        <footer>
            <span>Adithya Rajendran</span>
            <a href="/feed.xml">RSS</a>
            <a href={siteConfig.source}>Source</a>
            {sharedSky && (
                <a
                    class="sky-credit"
                    href="https://www.eso.org/public/images/eso0932a/"
                >
                    Sky: ESO / S. Brunier
                </a>
            )}
        </footer>
        <script>
            const themeButton =
                document.querySelector<HTMLButtonElement>("#theme-switch");
            if (themeButton) {
                themeButton.hidden = false;
                themeButton.addEventListener("click", () => {
                    const current =
                        document.documentElement.dataset.theme || "dark";
                    const next = current === "dark" ? "light" : "dark";
                    document.documentElement.dataset.theme = next;
                    try {
                        localStorage.setItem("theme", next);
                    } catch {}
                });
            }
            document
                .querySelectorAll<HTMLButtonElement>(".copy-code")
                .forEach((button) => {
                    const listing = button.closest(".listing");
                    const code = listing?.querySelector("code");
                    const status = listing?.querySelector(".copy-status");
                    const label = button.querySelector(".copy-code__label");
                    if (!code || !label || !navigator.clipboard?.writeText)
                        return;
                    let reset: ReturnType<typeof setTimeout> | undefined;
                    let copying = false;
                    button.hidden = false;
                    button.addEventListener("click", async () => {
                        if (copying) return;
                        copying = true;
                        clearTimeout(reset);
                        button.setAttribute("aria-busy", "true");
                        if (status) status.textContent = "";
                        try {
                            await navigator.clipboard.writeText(
                                code.textContent || "",
                            );
                            button.dataset.copyState = "copied";
                            button.title = "Copied to clipboard";
                            label.textContent = "Copied";
                            if (status)
                                status.textContent =
                                    "Code copied to clipboard.";
                            reset = setTimeout(() => {
                                delete button.dataset.copyState;
                                button.title = "Copy code";
                                label.textContent = "Copy";
                                if (status) status.textContent = "";
                            }, 2500);
                        } catch {
                            button.dataset.copyState = "error";
                            button.title =
                                "Couldn't copy. Try again, or select the code to copy it.";
                            label.textContent = "Retry";
                            if (status) status.textContent = button.title;
                        } finally {
                            copying = false;
                            button.removeAttribute("aria-busy");
                        }
                    });
                });
        </script>
    </body>
</html>
