---
import "../styles/secondary-visuals.css";
import SafeLink from "../components/SafeLink.astro";
import { buildProfilePage } from "../../lib/structured-data";
import Base from "../layouts/Base.astro";
import { getProfile, getAllProjects } from "../lib/sanity";
import { urlForImage } from "../lib/images";
import { missionOrder } from "../../lib/missions";
const [p, projects] = await Promise.all([getProfile(), getAllProjects()]);
const research = missionOrder(projects).find(
    (project) => !project.quiet && project.cover?.asset?._ref,
);
const biography =
    p?.bio?.split(/(?=At Canonical,|I started in security)/) || [];
---

<Base
    title="About"
    pageClass="about-page"
    structuredData={[
        {
            "@context": "https://schema.org",
            ...buildProfilePage({ profile: p }),
        },
    ]}
>
    <div class="editorial-lead about-lead-grid">
        <div class="about-lead-copy">
            <p class="eyebrow">The person behind the work</p>
            <h1>About</h1>
            {p?.headline && (
                <p class="editorial-lead__headline">{p.headline}</p>
            )}
            <div class="editorial-lead__body">
                {biography.map((paragraph) => (
                    <p>{paragraph.trim()}</p>
                ))}
            </div>
        </div>
        {research?.cover && (
            <figure class="about-research">
                <p class="eyebrow">From the work</p>
                <a href={`/portfolio/${research.slug}`}>
                    <img
                        src={urlForImage(research.cover)
                            .width(1200)
                            .fit("max")
                            .url()}
                        width={research.cover.dimensions?.width || 1200}
                        height={research.cover.dimensions?.height || 800}
                        alt={research.cover.alt || research.title}
                    />
                </a>
                <figcaption>
                    <a href={`/portfolio/${research.slug}`}>
                        {research.title} ↗
                    </a>
                    {research.cover.caption && <p>{research.cover.caption}</p>}
                </figcaption>
            </figure>
        )}
    </div>
    <div class="about-grid">
        <div>
            {p?.focusAreas?.length && (
                <section class="editorial-section">
                    <p class="eyebrow">01 / What I’m exploring</p>
                    <h2>Current focus</h2>
                    <ul class="about-focus">
                        {p.focusAreas.map((a) => (
                            <li>{a}</li>
                        ))}
                    </ul>
                </section>
            )}
            {p?.currentCuriosities?.length && (
                <section class="editorial-section">
                    <p class="eyebrow">02 / Open questions</p>
                    <h2>Curiosities</h2>
                    <ul class="editorial-rows">
                        {p.currentCuriosities.map((c) => (
                            <li>
                                <strong>{c.title}</strong>
                                {c.note && <p>{c.note}</p>}
                                {c.url && (
                                    <SafeLink href={c.url}>
                                        Read more ↗
                                    </SafeLink>
                                )}
                            </li>
                        ))}
                    </ul>
                </section>
            )}
        </div>
        <aside class="about-aside">
            <p class="eyebrow">Elsewhere</p>
            {p?.socialLinks?.length && (
                <ul>
                    {p.socialLinks.map((l) => (
                        <li>
                            <SafeLink href={l.url}>{l.label} ↗</SafeLink>
                        </li>
                    ))}
                </ul>
            )}
            <p>See the projects and questions taking shape.</p>
            <a class="section-link" href="/portfolio">
                Explore projects ↗
            </a>
            <p>
                <a class="section-link" href="/resume">
                    Explore the experience ↗
                </a>
            </p>
        </aside>
    </div>
    <section class="editorial-next">
        <p class="eyebrow">Continue the conversation</p>
        <h2>Let’s connect.</h2>
        <a class="section-link" href="/contact">
            Get in touch ↗
        </a>
    </section>
</Base>
