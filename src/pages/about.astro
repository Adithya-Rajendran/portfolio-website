---
import SafeLink from "../components/SafeLink.astro";
import { buildProfilePage } from "../../lib/structured-data";
import Base from "../layouts/Base.astro";
import { getProfile } from "../lib/sanity";
const p = await getProfile();
---

<Base
    title="About"
    structuredData={[
        {
            "@context": "https://schema.org",
            ...buildProfilePage({ profile: p }),
        },
    ]}
>
    <h1>About</h1>
    {p?.bio && <p>{p.bio}</p>}
    {p?.focusAreas?.length && (
        <section>
            <h2>Current focus</h2>
            <ul>
                {p.focusAreas.map((a) => (
                    <li>{a}</li>
                ))}
            </ul>
        </section>
    )}
    {p?.workSummary && (
        <section>
            <h2>Work</h2>
            <p>{p.workSummary}</p>
        </section>
    )}
    {p?.currentCuriosities?.length && (
        <section>
            <h2>Curiosities</h2>
            <ul>
                {p.currentCuriosities.map((c) => (
                    <li>
                        <strong>{c.title}</strong>
                        {c.note && <> · {c.note}</>}
                        {c.url && (
                            <>
                                {" "}
                                · <SafeLink href={c.url}>Read more</SafeLink>
                            </>
                        )}
                    </li>
                ))}
            </ul>
        </section>
    )}
    {p?.socialLinks?.length && (
        <section>
            <h2>Elsewhere</h2>
            <ul>
                {p.socialLinks.map((l) => (
                    <li>
                        <SafeLink href={l.url}>{l.label}</SafeLink>
                    </li>
                ))}
            </ul>
        </section>
    )}
</Base>
