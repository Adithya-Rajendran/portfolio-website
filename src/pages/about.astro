---
import "../styles/secondary-visuals.css";
import SafeLink from "../components/SafeLink.astro";
import { buildProfilePage } from "../../lib/structured-data";
import Base from "../layouts/Base.astro";
import { getProfile } from "../lib/sanity";
const p = await getProfile();
const biography =
    p?.bio?.split(/(?=At Canonical,|I started in security)/) || [];
---

<Base
    title="About"
    pageClass="about-page"
    structuredData={[
        {
            "@context": "https://schema.org",
            ...buildProfilePage({ profile: p }),
        },
    ]}
>
    <div class="editorial-lead about-lead-grid">
        <div class="about-lead-copy">
            <p class="eyebrow">The person behind the work</p>
            <h1>About</h1>
            {p?.headline && (
                <p class="editorial-lead__headline">{p.headline}</p>
            )}
            <div class="editorial-lead__body">
                {biography.map((paragraph) => (
                    <p>{paragraph.trim()}</p>
                ))}
            </div>
        </div>
        <figure class="about-portrait mechanical-study">
            <img
                src="/images/scenes/optics-study-v1.webp"
                width="1200"
                height="900"
                alt="A stereo camera study with twin optical lenses and a mechanical pan-and-tilt mount."
            />
            <figcaption>
                <span>01 / Perception</span> Seeing is where it begins.
            </figcaption>
        </figure>
    </div>
    <div class="about-grid">
        <div>
            {p?.focusAreas?.length && (
                <section class="editorial-section">
                    <p class="eyebrow">01 / What I’m exploring</p>
                    <h2>Current focus</h2>
                    <ul class="about-focus">
                        {p.focusAreas.map((a) => (
                            <li>{a}</li>
                        ))}
                    </ul>
                </section>
            )}
            {p?.workSummary && (
                <section class="editorial-section">
                    <p class="eyebrow">02 / The work</p>
                    <h2>Experience in context.</h2>
                    <p>{p.workSummary}</p>
                    <a class="section-link" href="/resume">
                        Explore the experience ↗
                    </a>
                </section>
            )}
            {p?.currentCuriosities?.length && (
                <section class="editorial-section">
                    <p class="eyebrow">03 / Open questions</p>
                    <h2>Curiosities</h2>
                    <ul class="editorial-rows">
                        {p.currentCuriosities.map((c) => (
                            <li>
                                <strong>{c.title}</strong>
                                {c.note && <p>{c.note}</p>}
                                {c.url && (
                                    <SafeLink href={c.url}>
                                        Read more ↗
                                    </SafeLink>
                                )}
                            </li>
                        ))}
                    </ul>
                </section>
            )}
        </div>
        <aside class="about-aside">
            <p class="eyebrow">Elsewhere</p>
            {p?.socialLinks?.length && (
                <ul>
                    {p.socialLinks.map((l) => (
                        <li>
                            <SafeLink href={l.url}>{l.label} ↗</SafeLink>
                        </li>
                    ))}
                </ul>
            )}
            <p>See the projects and questions taking shape.</p>
            <a class="section-link" href="/portfolio">
                Explore projects ↗
            </a>
        </aside>
    </div>
    <section class="editorial-next">
        <p class="eyebrow">Continue the conversation</p>
        <h2>Let’s connect.</h2>
        <a class="section-link" href="/contact">
            Get in touch ↗
        </a>
    </section>
</Base>
