---
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { getAllProjects, getProfile } from "../../lib/sanity";
import { homeProjects } from "../../../lib/home";
import { missionOrder } from "../../../lib/missions";
const [projects, profile] = await Promise.all([getAllProjects(), getProfile()]);
const { flagship, rows, also } = homeProjects(missionOrder(projects));
const selected = flagship ? [flagship, ...rows] : [];
---

<Base title="Projects" pageClass="projects-page">
    <div class="projects-intro-grid projects-intro-grid--work">
        <div>
            <p class="eyebrow">Selected work / Projects</p>
            <h1>Projects</h1>
            {profile?.projectsIntro && (
                <p class="page-intro">{profile.projectsIntro}</p>
            )}
        </div>
    </div>
    <ul class="project-collection" id="projects">
        {selected.map((project, index) => (
            <ProjectCard
                project={project}
                index={index}
                heading="h2"
                featured={index === 0}
            />
        ))}
    </ul>
    {also.length > 0 && (
        <section class="project-archive" aria-labelledby="more-projects-title">
            <p class="eyebrow">The wider body of work</p>
            <h2 id="more-projects-title">Experiments &amp; systems.</h2>
            <ul class="project-rows">
                {also.map((project, index) => (
                    <ProjectRow
                        project={project}
                        index={selected.length + index}
                    />
                ))}
            </ul>
        </section>
    )}
    <section class="projects-next">
        <p class="eyebrow">Keep exploring</p>
        <h2>More to discover.</h2>
        <a href="/blog">Read the writing ↗</a>
        <a href="/contact">Get in touch ↗</a>
    </section>
    <script>
        import { movedFragment } from "../../../lib/navigation";
        const follow = () => {
            const target = movedFragment(location.pathname, location.hash);
            if (target) location.replace(target);
        };
        follow();
        window.addEventListener("hashchange", follow);
    </script>
</Base>

<style>
    .projects-intro-grid--work {
        display: block;
        margin-bottom: 2.4rem;
        min-height: 0;
    }
    .projects-intro-grid--work h1 {
        margin-bottom: 0.25em;
    }
    .projects-intro-grid--work .page-intro {
        max-width: 52rem;
    }
    @media (max-width: 800px) {
        .projects-intro-grid--work {
            margin-bottom: 1.6rem;
        }
    }
</style>
