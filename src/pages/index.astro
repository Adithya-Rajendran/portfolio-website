---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import HeroVisual from "../components/HeroVisual.astro";
import { getProfile, getAllPosts, getAllProjects } from "../lib/sanity";
import { availabilityLine } from "../../lib/profile-content";
import { homeProjects } from "../../lib/home";
import { missionOrder } from "../../lib/missions";
import "../styles/home-frontier.css";
const [profile, posts, projects] = await Promise.all([
    getProfile(),
    getAllPosts(),
    getAllProjects(),
]);
const { flagship, rows } = homeProjects(missionOrder(projects));
const selected = flagship ? [flagship, ...rows] : [];
const availability = availabilityLine(profile?.availability);
---

<Base description={profile?.seoDescription || ""} pageClass="home-page">
    <section class="home-hero" aria-labelledby="hero-title">
        <HeroVisual />
        <div class="home-hero__veil"></div>
        <div class="home-hero__content">
            <p class="home-hero__kicker">
                Robotics <span>·</span> Perception <span>·</span> Systems
            </p>
            <h1 id="hero-title">
                Building toward
                <br />
                the <em>unknown.</em>
            </h1>
            <p class="home-hero__identity">
                {profile?.name || "Adithya Rajendran"}
                {profile?.headline && (
                    <>
                        {" "}
                        <span>—</span> {profile.headline}
                    </>
                )}
            </p>
            <p class="home-hero__intro">
                Exploring how machines see, understand, and act in the world.
            </p>
            <div class="home-hero__actions">
                <a class="hero-button hero-button--primary" href="/portfolio">
                    Explore the work <span aria-hidden="true">↗</span>
                </a>
                <a class="hero-button hero-button--secondary" href="/resume">
                    Enter orbit <span aria-hidden="true">↗</span>
                </a>
            </div>
            {availability && (
                <p class="home-hero__availability">
                    <span aria-hidden="true"></span> Open to: {availability}
                </p>
            )}
        </div>
        <div class="frontier-console">
            <div class="frontier-console__story">
                <span class="frontier-console__mark" aria-hidden="true"></span>
                <div>
                    <p class="frontier-console__eyebrow">
                        An imagined frontier
                    </p>
                    <p data-home-note>
                        Small machines. Uncharted possibilities.
                    </p>
                </div>
            </div>
            <div class="frontier-console__controls" data-home-controls hidden>
                <div role="group" aria-label="Explore the frontier">
                    <button
                        type="button"
                        data-home-destination="rover"
                        aria-pressed="true"
                    >
                        Rover
                    </button>
                    <button
                        type="button"
                        data-home-destination="outpost"
                        aria-pressed="false"
                    >
                        Outpost
                    </button>
                    <button
                        type="button"
                        data-home-destination="signal"
                        aria-pressed="false"
                    >
                        Signal
                    </button>
                </div>
                <button
                    type="button"
                    class="home-hero__motion"
                    data-home-motion
                    hidden
                >
                    Pause motion
                </button>
            </div>
        </div>
        <div class="home-hero__caption">
            <span data-home-hint hidden>
                Move your cursor to look around
            </span>
            <a href="/images/scenes/credits.txt">Scene credits ↗</a>
        </div>
    </section>
    <section
        class="home-section home-section--work"
        aria-labelledby="work-title"
    >
        <svg
            class="home-transfer"
            viewBox="0 0 1280 180"
            fill="none"
            aria-hidden="true"
        >
            <path d="M-80 165C240 165 345 18 710 40S1120 155 1370 96" />
            <path d="M-80 179C240 179 345 32 710 54S1120 169 1370 110" />
            <circle cx="710" cy="40" r="4" />
            <circle cx="710" cy="40" r="12" />
        </svg>
        <div class="section-heading">
            <div>
                <p class="eyebrow">01 / Selected work</p>
                <h2 id="work-title">Ideas made tangible.</h2>
            </div>
            <a class="section-link" href="/portfolio">
                All projects <span aria-hidden="true">↗</span>
            </a>
        </div>
        <ul class="project-collection">
            {selected.map((project, index) => (
                <ProjectCard
                    project={project}
                    index={index}
                    featured={index === 0}
                />
            ))}
        </ul>
    </section>
    {profile?.introduction && (
        <section class="home-introduction" aria-label="Introduction">
            <div class="home-introduction__heading">
                <p class="eyebrow">Behind the work</p>
                <h2>
                    Curiosity, with
                    <br />
                    <em>both feet on the ground.</em>
                </h2>
                <div class="home-aperture" aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <i></i>
                </div>
            </div>
            <div class="home-introduction__copy">
                <p>{profile.introduction}</p>
                <a class="section-link" href="/about">
                    More about me ↗
                </a>
            </div>
        </section>
    )}
    <section
        class="home-section home-section--writing"
        aria-labelledby="writing-title"
    >
        <div class="section-heading">
            <div>
                <p class="eyebrow">02 / Writing</p>
                <h2 id="writing-title">Notes from the field.</h2>
            </div>
            <a class="section-link" href="/blog">
                All writing <span aria-hidden="true">↗</span>
            </a>
        </div>
        <ul class="writing-list">
            {posts.slice(0, 3).map((post) => (
                <li>
                    <a href={`/blog/${post.slug}`}>
                        <time datetime={post.publishedAt}>
                            {post.publishedAt.slice(0, 10)}
                        </time>
                        <div>
                            <h3>{post.title}</h3>
                            <p>{post.description}</p>
                        </div>
                        <span aria-hidden="true">↗</span>
                    </a>
                </li>
            ))}
        </ul>
    </section>
    <section class="home-close">
        <p class="eyebrow">Start a conversation</p>
        <h2>Let’s build what comes next.</h2>
        <p class="home-close__intro">
            {profile?.contactIntro ||
                "An idea, a question, or an opportunity. I’d like to hear from you."}
        </p>
        <a class="section-link" href="/contact">
            Get in touch <span aria-hidden="true">↗</span>
        </a>
    </section>
</Base>
