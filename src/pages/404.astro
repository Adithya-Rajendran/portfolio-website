---
import Base from "../layouts/Base.astro";
---

<Base title="Not found" pageClass="not-found-page">
    <p class="eyebrow">An unexpected turn / 404</p>
    <h1>Page not found.</h1>
    <p>
        The page you requested could not be found. There’s still plenty to
        explore.
    </p>
    <div class="not-found-links">
        <a class="section-link" href="/">
            Return home ↗
        </a>
        <a class="section-link" href="/portfolio">
            Explore projects ↗
        </a>
    </div>
</Base>
