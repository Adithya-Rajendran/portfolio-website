---
import "../../styles/editorial.css";
import ReadingOrbit from "../../components/ReadingOrbit.astro";
import {
    buildBlogPosting,
    buildBreadcrumbList,
} from "../../../lib/structured-data";
import Base from "../../layouts/Base.astro";
import CmsImage from "../../components/CmsImage.astro";
import { urlForImage } from "../../lib/images";
import { extractHeadings, contentsHeadings } from "../../../lib/headings";
import { getPostBySlug, getAllPosts, getAllProjects } from "../../lib/sanity";
import { getProfile } from "../../lib/sanity";
import { siteConfig } from "../../../lib/config";
import { formatEntryDate, logEntries } from "../../../lib/log-index";
import { nextArticle } from "../../../lib/related-posts";
import { readingTimeFromWordCount } from "../../../lib/reading-time";
import { renderProse } from "../../lib/prose";
import { highlight } from "../../lib/highlight";
const post = await getPostBySlug(Astro.params.slug || "");
if (!post) return Astro.rewrite("/404");
const [highlighted, posts, projects, profile] = await Promise.all([
    highlight(post.body || []).catch(() => ({})),
    getAllPosts(),
    getAllProjects(),
    getProfile(),
]);
const relatedProjects = projects.filter((p) =>
    post.projectIds?.includes(p._id),
);
const headings = contentsHeadings(extractHeadings({ body: post.body }));
const entries = logEntries(posts);
const {
    entry: nextEntry,
    reason: nextReason,
    more: moreReading,
} = nextArticle(entries, posts, post);
const sharingImage = post.socialImage?.asset?._ref
    ? post.socialImage
    : post.cover;
const sharingUrl = sharingImage?.asset?._ref
    ? urlForImage(sharingImage).width(1200).height(630).fit("crop").url()
    : `${siteConfig.url}/share.png`;
const takeaways = Array.isArray(post.takeaways)
    ? post.takeaways.filter((text) => typeof text === "string" && text.trim())
    : [];
const readMinutes =
    post.wordCount > 0 ? readingTimeFromWordCount(post.wordCount) : null;
---

<Base
    pageClass="article-page"
    image={sharingUrl}
    imageAlt={sharingImage?.alt || post.title}
    ogType="article"
    structuredData={[
        {
            "@context": "https://schema.org",
            ...buildBlogPosting({
                title: post.title,
                description: post.description,
                publishedAt: post.publishedAt,
                slug: post.slug,
                revisedAt: post.revisedAt,
                tags: post.tags || [],
                wordCount: post.wordCount,
                imageUrl: sharingUrl,
            }),
        },
        buildBreadcrumbList([
            { name: "Writing", path: "/blog" },
            { name: post.title, path: `/blog/${post.slug}` },
        ]),
    ]}
    title={post.title}
    description={post.description}
>
    <article class="editorial-article">
        <div class="editorial-article-head">
            <p class="editorial-eyebrow">
                <a href="/blog">← Writing</a>
            </p>
            <h1>{post.title}</h1>
            <p class="editorial-deck">{post.description}</p>
            <p class="editorial-meta">
                <time datetime={post.publishedAt}>
                    {formatEntryDate(post.publishedAt)}
                </time>{" "}
                · <a href="/about">Adithya Rajendran</a>
                {readMinutes && <span> · {readMinutes} min read</span>}
                {post.revisedAt && post.revisedAt > post.publishedAt && (
                    <span class="editorial-updated">
                        Updated{" "}
                        <time datetime={post.revisedAt}>
                            {formatEntryDate(post.revisedAt)}
                        </time>
                    </span>
                )}
            </p>
            <ReadingOrbit />
        </div>
        <CmsImage image={post.cover} />
        {takeaways.length > 0 && (
            <aside class="article-takeaways" aria-labelledby="takeaways-title">
                <h2 id="takeaways-title">Key takeaways</h2>
                <ul>
                    {takeaways.map((text) => (
                        <li>{text}</li>
                    ))}
                </ul>
            </aside>
        )}
        {headings.length > 1 && (
            <details class="contents" id="article-contents">
                <summary>
                    Contents{" "}
                    <span class="contents__count">
                        {headings.length} sections
                    </span>
                </summary>
                <nav aria-label="Contents">
                    <ol>
                        {headings.map((h) => (
                            <li>
                                <a href={`#${h.id}`}>{h.text}</a>
                            </li>
                        ))}
                    </ol>
                </nav>
            </details>
        )}
        <div
            class="prose"
            set:html={renderProse(post.body || [], highlighted)}
        />
        {headings.length > 1 && (
            <p class="article-return">
                <a href="#article-contents">Back to contents ↑</a>
            </p>
        )}
        {post.changelog?.length && (
            <section>
                <h2>Revisions</h2>
                <ul>
                    {post.changelog.map((c) => (
                        <li>
                            <time datetime={c.date}>{c.date}</time> · {c.note}
                        </li>
                    ))}
                </ul>
            </section>
        )}
        {post.tags?.length && (
            <p>
                Topics:{" "}
                {post.tags.map((t) => (
                    <>
                        {" "}
                        <a href={`/blog/tags/${t}`}>{t}</a>
                    </>
                ))}
            </p>
        )}
        {relatedProjects.length > 0 && (
            <section>
                <h2>Related projects</h2>
                <ul>
                    {relatedProjects.map((project) => (
                        <li>
                            <a href={`/portfolio/${project.slug}`}>
                                {project.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )}
        {nextEntry && (
            <section class="article-next" aria-labelledby="read-next-title">
                <h2 id="read-next-title">Read next</h2>
                <h3>
                    <a href={`/blog/${nextEntry.slug}`}>
                        {nextEntry.title} <span aria-hidden="true">↗</span>
                    </a>
                </h3>
                {nextReason && <p>{nextReason}</p>}
                {nextEntry.readMinutes && (
                    <p class="article-next__time">
                        {nextEntry.readMinutes} min read
                    </p>
                )}
                {moreReading.length > 0 && (
                    <details class="article-more">
                        <summary>More on these topics</summary>
                        <ul>
                            {moreReading.map((p) => (
                                <li>
                                    <a href={`/blog/${p.slug}`}>{p.title}</a>
                                </li>
                            ))}
                        </ul>
                    </details>
                )}
            </section>
        )}
        <section class="article-author" aria-labelledby="article-author-title">
            <p class="editorial-eyebrow">Behind the work</p>
            <h2 id="article-author-title">
                <a href="/about">{profile?.name || siteConfig.author}</a>
            </h2>
            {profile?.introduction && <p>{profile.introduction}</p>}
            <p>
                <a href="/about">More about me</a> ·{" "}
                <a href="/portfolio">Explore my projects</a>
            </p>
            <div class="article-follow">
                <h3>Follow my work</h3>
                <p>
                    Get new posts through RSS, or connect with me on LinkedIn.
                </p>
                <div class="article-follow__links">
                    <a
                        class="article-follow__primary"
                        href={siteConfig.profiles.linkedin}
                    >
                        Follow on LinkedIn <span aria-hidden="true">↗</span>
                    </a>
                    <a href="/feed.xml">
                        Subscribe via RSS <span aria-hidden="true">↗</span>
                    </a>
                </div>
            </div>
        </section>
    </article>
</Base>
