---
import "../styles/space.css";
import type { SpaceStudy } from "../scripts/space-studies";
interface Props {
    kind: SpaceStudy;
    compact?: boolean;
}
const { kind, compact = false } = Astro.props;
const scenes = {
    workshop: {
        name: "The orbital workshop",
        note: "An imagined research station above the Moon.",
        coordinate: "01 / Build",
    },
    observatory: {
        name: "Signals from the unknown",
        note: "A deep-space observatory, looking a little further.",
        coordinate: "02 / Discover",
    },
    robotics: {
        name: "A different way of seeing",
        note: "A robotic perception instrument on a research workbench overlooking an imagined Martian landscape.",
        coordinate: "03 / Explore",
    },
    relay: {
        name: "An open channel",
        note: "A communications relay above our home planet.",
        coordinate: "04 / Connect",
    },
};
const scene = scenes[kind];
---

<figure
    class:list={["space-study", { "space-study--compact": compact }]}
    data-space-study={kind}
    data-state="loading"
>
    <div class="space-study__art">
        <picture
            class="space-study__poster"
            data-space-poster
            aria-hidden="true"
        >
            <source
                media="(max-width: 800px)"
                srcset={`/images/scenes/${kind}-mobile-v2.webp`}
            />
            <img
                src={`/images/scenes/${kind}-desktop-v2.webp`}
                alt=""
                width="1440"
                height="1080"
                decoding="async"
                fetchpriority="high"
            />
        </picture>
        <div
            class="space-study__stage"
            data-space-stage
            role="img"
            aria-label={scene.note}
            aria-describedby={`space-instructions-${kind}`}
        ></div>
    </div>
    <figcaption class="space-study__caption">
        <span class="space-study__coordinate">{scene.coordinate}</span>
        <span class="space-study__name">{scene.name}</span>
    </figcaption>
    <div class="space-study__controls" role="group" aria-label="Scene controls">
        <button type="button" data-space-motion aria-pressed="false" hidden>
            Pause motion
        </button>
        <button type="button" data-space-closer aria-label="Zoom in">
            +
        </button>
        <button type="button" data-space-further aria-label="Zoom out">
            −
        </button>
        <button type="button" data-space-reset>
            Reset view
        </button>
    </div>
    <p
        class="space-study__hint"
        id={`space-instructions-${kind}`}
        data-space-hint
        hidden
    >
        Drag to orbit · Arrow keys to look · Scroll to keep reading
    </p>
    <a
        class="space-study__credits"
        href="/images/trajectory/README.md#secondary-scenes"
    >
        Scene credits ↗
    </a>
    {kind === "relay" && <script is:inline nonce={Astro.locals.cspNonce}>
        {
            const picture = document.currentScript
                ?.closest("figure")
                ?.querySelector("[data-space-poster]");
            const phase = document.documentElement.dataset.scenePhase;
            if (
                picture &&
                ["dawn", "day", "dusk", "night"].includes(phase || "")
            ) {
                picture.querySelector("source").srcset =
                    `/images/scenes/relay-${phase}-mobile-v2.webp`;
                picture.querySelector("img").src =
                    `/images/scenes/relay-${phase}-desktop-v2.webp`;
            }
        }
    </script>}
</figure>
<script>
    import "../scripts/space-scene";
</script>
