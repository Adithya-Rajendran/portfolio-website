---
interface Props {
    entries: {
        id: string;
        title: string;
        organization?: string | null;
        dates: string;
    }[];
}
const { entries } = Astro.props;
---

{entries.length > 0 && (
    <section
        class="experience-visual"
        hidden
        aria-labelledby="experience-visual-title"
    >
        <div class="experience-visual__head">
            <div>
                <p class="experience-visual__eyebrow">An interactive view</p>
                <h2 id="experience-visual-title">A trajectory of work</h2>
            </div>
            <button type="button" data-experience-start>
                Start visual
            </button>
        </div>
        <p class="experience-visual__help">
            Explore the visual with your pointer or arrow keys. The complete
            experience is available in the list below.
        </p>
        <div
            class="experience-visual__controls"
            data-experience-controls
            hidden
        >
            <button type="button" data-experience-motion>
                Pause motion
            </button>
            <p>
                Select an entry to highlight it in the visual and read its
                details.
            </p>
            <ol>
                {entries.map((entry, index) => (
                    <li>
                        <button
                            type="button"
                            data-experience-entry={index}
                            aria-pressed="false"
                        >
                            {entry.title}
                        </button>
                    </li>
                ))}
            </ol>
            <div aria-live="polite">
                {entries.map((entry, index) => (
                    <div data-experience-detail={index} hidden>
                        <strong>{entry.title}</strong>
                        {entry.organization && <> · {entry.organization}</>}
                        {entry.dates && <> · {entry.dates}</>}{" "}
                        <a href={`#${entry.id}`}>View full entry</a>
                    </div>
                ))}
            </div>
        </div>
        <div
            class="experience-visual__stage"
            data-experience-stage
            tabindex="0"
            aria-label="Interactive experience visual. Use arrow keys to rotate."
            hidden
        ></div>
        <p data-experience-status role="status"></p>
    </section>
)}
<script>
    import "../scripts/experience";
</script>
<style>
    .experience-visual {
        margin: 3rem 0;
        border-block: 1px solid currentColor;
        padding: 1.5rem 0;
    }
    .experience-visual__head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .experience-visual__head h2 {
        margin: 0;
    }
    .experience-visual__eyebrow {
        font-size: 0.8rem;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }
    .experience-visual__help {
        max-width: 60ch;
    }
    .experience-visual__stage {
        height: clamp(280px, 45vw, 520px);
        background: #101a24;
        overflow: hidden;
        touch-action: none;
    }
    .experience-visual__stage :global(canvas) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .experience-visual__controls ol {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0;
        list-style: none;
    }
    .experience-visual__controls button[aria-pressed="true"] {
        outline: 2px solid currentColor;
    }
    @media print {
        .experience-visual {
            display: none;
        }
    }
</style>
