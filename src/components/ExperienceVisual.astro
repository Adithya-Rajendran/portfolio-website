---
const worlds = ["Earth", "Moon", "Mars", "Jupiter", "Saturn"];
---

<section class="experience-visual" aria-labelledby="experience-visual-title">
    <div class="experience-visual__head">
        <h2 id="experience-visual-title">Orbital view</h2>
        <button type="button" data-experience-start hidden>
            Start exploring
        </button>
    </div>
    <div class="observatory">
        <div class="observatory__viewport">
            <div
                class="observatory__poster"
                data-experience-poster
                aria-hidden="true"
            >
                <div class="observatory__earth"></div>
            </div>
            <div
                class="observatory__stage"
                data-experience-stage
                tabindex="0"
                aria-label="Orbital view. Drag or use arrow keys to orbit; use plus and minus to zoom and Home to reset."
                hidden
            ></div>
            <div
                class="observatory__label"
                aria-live="polite"
                data-experience-current
            >
                Earth
            </div>
        </div>
        <div class="observatory__controls" data-experience-controls hidden>
            <div
                class="observatory__worlds"
                role="group"
                aria-label="Choose a world"
            >
                {worlds.map((world) => (
                    <button
                        type="button"
                        data-experience-world={world.toLowerCase()}
                        aria-pressed={world === "Earth"}
                    >
                        {world}
                    </button>
                ))}
            </div>
            <div class="observatory__actions">
                <button type="button" data-experience-reset>
                    Reset view
                </button>
                <button type="button" data-experience-motion>
                    Pause motion
                </button>
            </div>
        </div>
        <p class="observatory__status" data-experience-status role="status"></p>
    </div>
    <p class="experience-visual__hint">
        Drag to orbit · Focus to zoom · On touch, use two fingers · Worlds are
        illustrative.
    </p>
    <noscript>
        <p>
            The interactive orbital view requires JavaScript. The experience
            record remains available below.
        </p>
    </noscript>
    <p class="experience-visual__credit">
        Maps: <a href="https://visibleearth.nasa.gov/">NASA</a> and{" "}
        <a href="https://www.solarsystemscope.com/textures/">
            Solar System Scope
        </a>{" "}
        (<a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>),
        adapted. <a href="/images/trajectory/README.md">Image credits</a>.
    </p>
</section>
<script>
    import "../scripts/experience";
</script>
<style>
    .experience-visual {
        color: #f2e9d7;
    }
    .experience-visual__head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
    }
    .experience-visual__head h2 {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
        font:
            0.72rem DMMono,
            monospace;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: #b7d2ae;
    }
    .experience-visual__head button {
        color: #f2e9d7;
        border-color: #8c9c90;
        font-size: 0.8rem;
    }
    .observatory {
        background: #090e10;
    }
    .observatory__viewport {
        position: relative;
        height: clamp(500px, 43vw, 620px);
        overflow: hidden;
        background: #080d12;
    }
    .observatory__controls[hidden],
    .observatory__stage[hidden],
    .observatory__poster[hidden] {
        display: none;
    }
    .observatory__poster,
    .observatory__stage {
        position: absolute;
        inset: 0;
        overflow: hidden;
    }
    .observatory__poster {
        background: radial-gradient(
            ellipse at 53% 50%,
            #1b2a30,
            #0a1116 45%,
            #05090e
        );
    }
    .observatory__poster::before {
        content: "";
        position: absolute;
        inset: 0;
        background: url("/images/trajectory/milky-way-band-2k.webp") center /
            cover;
        opacity: 0.16;
    }
    .observatory__earth {
        position: absolute;
        width: min(54%, 390px);
        aspect-ratio: 1;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        background:
            radial-gradient(
                circle at 31% 28%,
                transparent 9%,
                #050d184d 53%,
                #040b13 79%
            ),
            url("/images/trajectory/earth-2k.webp") 30% 48% / auto 100%;
        box-shadow:
            inset -25px -14px 45px #030913,
            inset 5px 2px 14px #b9dcf366,
            0 0 18px #7ab5d12c;
    }
    .observatory__stage {
        touch-action: pan-y;
    }
    .observatory__stage :global(canvas) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .observatory__label {
        position: absolute;
        left: 1rem;
        bottom: 1rem;
        color: #f2e9d7;
        font:
            0.72rem DMMono,
            monospace;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        pointer-events: none;
    }
    .observatory__controls {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.7rem;
        flex-wrap: wrap;
        padding: 0.8rem 0;
        border-bottom: 1px solid #53605a;
    }
    .observatory__worlds,
    .observatory__actions {
        display: flex;
        gap: 0.25rem;
        flex-wrap: wrap;
    }
    .observatory__controls button {
        color: #f2e9d7;
        border-color: #84928a;
        font-size: 0.8rem;
        padding: 0.4rem 0.7rem;
    }
    .observatory__controls button[aria-pressed="true"] {
        color: #171915;
        background: var(--accent-amber);
        border-color: var(--accent-amber);
    }
    .observatory__controls button:hover {
        color: #171915;
    }
    .observatory__status {
        margin: 0;
        color: #f2e9d7;
    }
    .experience-visual__hint,
    .experience-visual__credit {
        color: #c2cfc1;
        font-size: 0.8rem;
    }
    .experience-visual a {
        color: #f0b87c;
    }
    @media (max-width: 800px) {
        .observatory__viewport {
            height: 300px;
        }
        .observatory__earth {
            width: min(65%, 250px);
        }
    }
    @media print {
        .experience-visual {
            display: none;
        }
    }
</style>
