---
import SceneCameraTools from "./SceneCameraTools.astro";
const worlds = ["Earth", "Moon", "Mars", "Jupiter", "Saturn"];
---

<section
    class="experience-visual"
    data-layout="arrival"
    aria-labelledby="experience-visual-title"
>
    <div class="experience-visual__head">
        <h2 id="experience-visual-title">Orbital view</h2>
        <button type="button" data-experience-start hidden>
            Start exploring
        </button>
    </div>
    <div class="observatory">
        <div class="observatory__viewport">
            <svg
                class="observatory__paths"
                viewBox="0 0 900 800"
                aria-hidden="true"
            >
                <ellipse
                    cx="455"
                    cy="395"
                    rx="425"
                    ry="260"
                    transform="rotate(-36 455 395)"
                />
                <ellipse
                    cx="455"
                    cy="395"
                    rx="440"
                    ry="330"
                    transform="rotate(27 455 395)"
                />
                <circle cx="222" cy="124" r="3" />
                <circle cx="786" cy="615" r="3" />
            </svg>
            <div
                id="experience-camera-surface"
                class="observatory__stage"
                data-experience-stage
                data-scene-camera-surface
                role="region"
                tabindex="0"
                aria-label="Orbital journey camera"
                hidden
            ></div>
            <SceneCameraTools surfaceId="experience-camera-surface" />
            <div
                class="observatory__label"
                aria-live="polite"
                data-experience-current
            >
                Earth
            </div>
        </div>
        <div class="observatory__controls" data-experience-controls hidden>
            <div
                class="observatory__worlds"
                role="group"
                aria-label="Choose a world"
            >
                {worlds.map((world) => (
                    <button
                        type="button"
                        data-experience-world={world.toLowerCase()}
                        aria-pressed={world === "Earth"}
                    >
                        {world}
                    </button>
                ))}
            </div>
            <div class="observatory__actions">
                <button type="button" data-experience-motion>
                    Pause motion
                </button>
                <button
                    type="button"
                    data-experience-replay
                    aria-label="Replay the guided tour"
                >
                    ↺ Replay
                </button>
            </div>
        </div>
        <p class="observatory__status" data-experience-status role="status"></p>
    </div>
    <div class="experience-visual__caption">
        <p class="experience-visual__destination" data-experience-destination>
            Earth · Our starting point
        </p>
        <p class="experience-visual__hint">
            <span data-experience-navigation>Scroll to travel</span>
            <span data-experience-lighting>Day · your local time</span>
        </p>
    </div>
    <p class="experience-visual__sky-credit">
        Milky Way:{" "}
        <a href="https://www.eso.org/public/images/eso0932a/">ESO/S. Brunier</a>
    </p>
    <noscript>
        <p>
            The interactive orbital view requires JavaScript. The experience
            record remains available below.
        </p>
    </noscript>
    <details class="experience-visual__details">
        <summary>Controls &amp; credits</summary>
        <p>
            Scroll through the record to move between worlds. Choose Explore
            scene to orbit, pan and zoom. Use Reset view to restore the current
            world's framing, and Done or Escape to return to the journey. Dawn,
            day, dusk, and night follow your device's local clock. Lighting is
            illustrative and uses your device's time without location or live
            weather. Satellites are enlarged for visibility. Moon and Mars
            arrivals reveal original architectural concepts at an illustrated
            scale, attached to their planet’s curved surface. The lunar rail
            launches a satellite, unfolds its solar panels, and returns the
            carriage for the next departure. This repeating sequence pauses with
            the other motion.
        </p>
        <p>
            Surface references:{" "}
            <a href="https://ntrs.nasa.gov/citations/20230014593">
                NASA Mars Surface Habitat
            </a>
            ,<a href="https://www.spacex.com/mars">SpaceX Mission: Mars</a>, and
            <a href="https://nss.org/l5-news-mass-driver-update/">
                O’Neill’s mass-driver research
            </a>
            . These are imagined future settlements.{" "}
            <a href="#settlements">
                What each structure is for, and what it is modelled on
            </a>
            , is listed after the record.
        </p>
        <p class="experience-visual__credit">
            Maps: <a href="https://visibleearth.nasa.gov/">NASA</a> and{" "}
            <a href="https://www.solarsystemscope.com/textures/">
                Solar System Scope
            </a>{" "}
            (
            <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
            ), adapted. <a href="/images/trajectory/README.md">Image credits</a>
            .
        </p>
    </details>
</section>
<script>
    import "../scripts/experience";
</script>
<style>
    .experience-visual {
        position: relative;
        color: #f2e9d7;
        isolation: isolate;
    }
    .experience-visual__head h2,
    .observatory__label {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
    .experience-visual__head button {
        position: absolute;
        top: 42%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 5;
    }
    .observatory__viewport {
        position: relative;
        height: clamp(430px, 43vw, 650px);
        background: transparent;
    }
    .observatory__paths {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        fill: none;
        stroke: #8a9d59;
        stroke-width: 0.6;
        opacity: 0.2;
        pointer-events: none;
    }
    .observatory__paths ellipse:first-child {
        stroke: #b47a51;
    }
    .observatory__paths circle {
        fill: #94aa70;
        stroke: none;
    }
    .experience-visual[data-surface="true"] .observatory__paths {
        opacity: 0;
    }
    .observatory__stage {
        position: absolute;
        inset: 0;
        touch-action: pan-y;
    }
    [data-exploring="true"] .observatory__stage {
        cursor: grab;
    }
    [data-exploring="true"] .observatory__stage:active {
        cursor: grabbing;
    }
    .observatory__stage:focus-visible {
        outline: none;
    }
    .observatory__viewport:has(.observatory__stage:focus-visible) {
        outline: 2px solid #dfa05d;
        outline-offset: -2px;
    }
    .observatory__stage :global(canvas) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .observatory__stage[data-surface="true"] {
        mask-image:
            linear-gradient(
                to bottom,
                transparent,
                #000 7%,
                #000 82%,
                transparent
            ),
            linear-gradient(
                to right,
                transparent,
                #000 7%,
                #000 94%,
                transparent
            );
        mask-composite: intersect;
    }
    .observatory__controls[hidden],
    .observatory__stage[hidden] {
        display: none;
    }
    .observatory__controls {
        position: relative;
        z-index: 4;
        width: min(100%, 37rem);
        margin: -0.5rem auto 0;
    }
    .observatory__worlds {
        display: flex;
        justify-content: space-between;
        gap: 0.35rem;
        border-bottom: 1px solid #c1cfbc29;
    }
    .observatory__controls button {
        min-height: 44px;
        border: 0;
        border-radius: 0;
        color: #d7ded7;
        background: transparent;
        font:
            0.82rem DMMono,
            monospace;
        padding: 0.5rem 0.65rem;
        cursor: pointer;
    }
    .observatory__worlds button {
        border-bottom: 2px solid transparent;
    }
    .observatory__worlds button[aria-pressed="true"] {
        color: #edb575;
        border-bottom-color: #dfa05d;
    }
    .observatory__controls button:hover {
        color: #ffcf95;
    }
    .observatory__controls button:focus-visible {
        outline: 2px solid #dfa05d;
        outline-offset: 2px;
    }
    .observatory__actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.6rem;
        padding-top: 0.2rem;
    }
    .observatory__actions [data-experience-motion] {
        color: #f2d1a7;
        font-family: inherit;
    }
    .observatory__status:empty {
        display: none;
    }
    .observatory__status {
        font-size: 0.8rem;
        text-align: center;
        color: #c1cbbf;
    }
    .experience-visual__caption {
        text-align: center;
        margin: 0.7rem auto 0.4rem;
    }
    .experience-visual__destination {
        font:
            0.78rem DMMono,
            monospace;
        color: #d3dccb;
        margin: 0 0 0.4rem;
        max-width: none;
    }
    .experience-visual__hint {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.3rem 1.2rem;
        font:
            0.72rem DMMono,
            monospace;
        color: #a8b5ac;
        margin: 0;
        max-width: none;
    }
    .experience-visual__sky-credit {
        font-size: 0.7rem;
        color: #aab3b7;
        text-align: center;
        max-width: none;
        margin: 0.6rem 0 0.3rem;
    }
    .experience-visual__sky-credit a {
        color: #c6c8c1;
        text-underline-offset: 0.2em;
    }
    .experience-visual__details {
        font-size: 0.78rem;
        color: #a8b5ac;
        text-align: center;
        max-width: 38rem;
        margin: auto;
    }
    .experience-visual__details summary {
        cursor: pointer;
        min-height: 40px;
        padding: 0.5rem;
    }
    .experience-visual__details p {
        margin: 0.5rem auto;
        text-align: left;
    }
    .experience-visual__details a {
        color: #d4b58c;
    }
    /* Names hung over the structures of a settlement; made by the script. */
    .observatory__viewport :global(.observatory__captions) {
        position: absolute;
        inset: 0;
        z-index: 1;
        overflow: hidden;
        pointer-events: none;
    }
    .observatory__viewport :global(.observatory__captions span) {
        position: absolute;
        top: 0;
        left: 0;
        opacity: 0;
        transition: opacity 0.4s ease;
    }
    .observatory__viewport :global(.observatory__captions span[data-shown]) {
        opacity: 1;
    }
    .observatory__viewport :global(.observatory__captions span::before) {
        content: "";
        position: absolute;
        bottom: 3px;
        left: -0.5px;
        width: 1px;
        height: 22px;
        background: linear-gradient(to top, #f2e9d7e6, #f2e9d740);
    }
    .observatory__viewport :global(.observatory__captions span::after) {
        content: "";
        position: absolute;
        top: -2.5px;
        left: -2.5px;
        box-sizing: border-box;
        width: 5px;
        height: 5px;
        border: 1px solid #f2e9d7e6;
        border-radius: 50%;
        background: #0a0d0c99;
    }
    .observatory__viewport :global(.observatory__captions b) {
        position: absolute;
        bottom: 27px;
        left: 0;
        transform: translateX(-50%);
        padding: 0.12rem 0.42rem;
        border: 1px solid #f2e9d726;
        border-radius: 2px;
        background: #0a0d0c8c;
        color: #f6eedd;
        font:
            500 0.66rem DMMono,
            monospace;
        letter-spacing: 0.09em;
        text-transform: uppercase;
        white-space: nowrap;
    }
    @media (min-width: 801px) {
        .observatory__viewport {
            /* The orbital art reaches behind the intro and past the grid. */
            --scene-camera-tools-top: auto;
            --scene-camera-tools-right: 3.5rem;
            --scene-camera-tools-bottom: 1rem;
            --scene-camera-help-bottom: 4.8rem;
        }
    }
    @media (min-width: 801px) and (max-height: 850px) {
        .observatory__viewport {
            height: max(280px, calc(100svh - 290px));
        }
    }
    @media (max-width: 800px) {
        .observatory__viewport {
            height: clamp(230px, 64vw, 330px);
            transition: height 0.45s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .observatory__paths {
            opacity: 0.15;
        }
        .observatory__controls {
            margin-top: 0;
        }
        .observatory__worlds {
            gap: 0;
        }
        .observatory__worlds button {
            font-size: 0.8rem;
            padding-inline: 0.45rem;
            min-width: 44px;
        }
        .observatory__actions {
            gap: 0.15rem;
        }
        .observatory__controls button {
            font-size: 0.78rem;
            padding-inline: 0.4rem;
        }
        .experience-visual__caption {
            margin-top: 0.4rem;
        }
        .experience-visual__destination {
            font-size: 0.72rem;
        }
        .experience-visual__hint {
            font-size: 0.68rem;
        }
        .experience-visual[data-layout="compact"] .observatory__viewport {
            height: 142px;
        }
        .experience-visual[data-layout="compact"] .experience-visual__caption,
        .experience-visual[data-layout="compact"] .experience-visual__details {
            display: none;
        }
        .experience-visual[data-layout="compact"]
            .experience-visual__sky-credit {
            margin: 0.2rem 0 0.5rem;
            font-size: 0.65rem;
        }
        .experience-visual[data-layout="expanded"] .observatory__viewport {
            height: max(260px, calc(82svh - 160px));
        }
        .experience-visual[data-layout="expanded"] .experience-visual__details {
            display: none;
        }
    }
    @media (prefers-reduced-motion: reduce) {
        .observatory__viewport,
        .observatory__viewport :global(.observatory__captions span) {
            transition: none;
        }
    }
    @media print {
        .experience-visual {
            display: none;
        }
    }
</style>
