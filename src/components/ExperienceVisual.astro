---
const worlds = ["Earth", "Moon", "Mars", "Jupiter", "Saturn"];
---

<section class="experience-visual" aria-labelledby="experience-visual-title">
    <div class="experience-visual__head">
        <h2 id="experience-visual-title">Orbital view</h2>
        <button type="button" data-experience-start hidden>
            Start exploring
        </button>
    </div>
    <div class="observatory">
        <div class="observatory__viewport">
            <svg
                class="observatory__paths"
                viewBox="0 0 900 800"
                aria-hidden="true"
            >
                <ellipse
                    cx="455"
                    cy="395"
                    rx="425"
                    ry="260"
                    transform="rotate(-36 455 395)"
                />
                <ellipse
                    cx="455"
                    cy="395"
                    rx="440"
                    ry="330"
                    transform="rotate(27 455 395)"
                />
                <circle cx="222" cy="124" r="3" />
                <circle cx="786" cy="615" r="3" />
            </svg>
            <div
                class="observatory__poster"
                data-experience-poster
                aria-hidden="true"
            >
                <div class="observatory__earth"></div>
            </div>
            <div
                class="observatory__stage"
                data-experience-stage
                tabindex="0"
                aria-label="Orbital journey. Scroll the page to travel between planets. Drag or use arrow keys to orbit; use plus and minus to zoom and Home to reset."
                hidden
            ></div>
            <div
                class="observatory__label"
                aria-live="polite"
                data-experience-current
            >
                Earth
            </div>
        </div>
        <div class="observatory__controls" data-experience-controls hidden>
            <div
                class="observatory__worlds"
                role="group"
                aria-label="Choose a world"
            >
                {worlds.map((world) => (
                    <button
                        type="button"
                        data-experience-world={world.toLowerCase()}
                        aria-pressed={world === "Earth"}
                    >
                        {world}
                    </button>
                ))}
            </div>
            <div class="observatory__actions">
                <button
                    type="button"
                    data-experience-zoom="+"
                    aria-label="Zoom in"
                >
                    +
                </button>
                <button
                    type="button"
                    data-experience-zoom="-"
                    aria-label="Zoom out"
                >
                    −
                </button>
                <button type="button" data-experience-reset>
                    Reset view
                </button>
                <button type="button" data-experience-motion>
                    Pause motion
                </button>
            </div>
        </div>
        <p class="observatory__status" data-experience-status role="status"></p>
    </div>
    <p class="experience-visual__hint">
        Scroll to travel <span aria-hidden="true">↓</span>{" "}
        <span data-experience-navigation>Drag to orbit</span>
    </p>
    <p class="experience-visual__lighting" data-experience-lighting>
        An Earth for every hour.
    </p>
    <p class="experience-visual__destination" data-experience-destination>
        Earth · Two paths around our home
    </p>
    <p class="experience-visual__sky-credit">
        Milky Way:{" "}
        <a href="https://www.eso.org/public/images/eso0932a/">ESO/S. Brunier</a>
    </p>
    <noscript>
        <p>
            The interactive orbital view requires JavaScript. The experience
            record remains available below.
        </p>
    </noscript>
    <details class="experience-visual__details">
        <summary>Controls &amp; credits</summary>
        <p>
            Scroll through the record to move between worlds. Use arrow keys to
            orbit, + / − to zoom, and Home to reset. On touch, drag with two
            fingers. Dawn, day, dusk, and night follow your device's local
            clock. Lighting is illustrative; it does not use your location or
            live weather. Satellites are enlarged for visibility. Moon and Mars
            arrivals reveal original architectural concepts at surface scale.
        </p>
        <p>
            Surface references:{" "}
            <a href="https://ntrs.nasa.gov/citations/20230014593">
                NASA Mars Surface Habitat
            </a>
            ,<a href="https://www.spacex.com/mars">SpaceX Mission: Mars</a>, and
            <a href="https://nss.org/l5-news-mass-driver-update/">
                O’Neill’s mass-driver research
            </a>
            . These are imagined future settlements.
        </p>
        <p class="experience-visual__credit">
            Maps: <a href="https://visibleearth.nasa.gov/">NASA</a> and{" "}
            <a href="https://www.solarsystemscope.com/textures/">
                Solar System Scope
            </a>{" "}
            (
            <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>
            ), adapted. <a href="/images/trajectory/README.md">Image credits</a>
            .
        </p>
    </details>
</section>
<script>
    import "../scripts/experience";
</script>
<style>
    .experience-visual {
        position: relative;
        color: #f2e9d7;
        isolation: isolate;
    }
    .experience-visual__head h2 {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }
    .experience-visual__head button {
        position: absolute;
        top: 42%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 5;
    }
    .observatory {
        background: transparent;
    }
    .observatory__viewport {
        position: relative;
        height: clamp(500px, 43vw, 670px);
        overflow: visible;
        background: transparent;
    }
    .observatory__paths {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        fill: none;
        stroke: #8a9d59;
        stroke-width: 0.7;
        opacity: 0.3;
        pointer-events: none;
    }
    .observatory__paths ellipse:first-child {
        stroke: #b47a51;
    }
    .observatory__paths circle {
        fill: #94aa70;
        stroke: none;
    }
    .experience-visual[data-view="surface"] .observatory__paths {
        opacity: 0;
    }
    .observatory__stage,
    .observatory__poster {
        position: absolute;
        inset: 0;
    }
    .observatory__stage {
        touch-action: pan-y;
    }
    .observatory__stage :global(canvas) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .observatory__stage[data-view="surface"] {
        mask-image: radial-gradient(
            ellipse 75% 65% at 52% 45%,
            #000 40%,
            #000d 66%,
            transparent 98%
        );
    }
    .observatory__controls[hidden],
    .observatory__stage[hidden],
    .observatory__poster[hidden] {
        display: none;
    }
    .observatory__earth {
        position: absolute;
        width: 83%;
        max-width: 660px;
        aspect-ratio: 1;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        background: url("/images/trajectory/earth-poster-v2-day.webp") center /
            contain no-repeat;
    }
    .experience-visual[data-phase="dawn"] .observatory__earth {
        background-image: url("/images/trajectory/earth-poster-v2-dawn.webp");
    }
    .experience-visual[data-phase="dusk"] .observatory__earth {
        background-image: url("/images/trajectory/earth-poster-v2-dusk.webp");
    }
    .experience-visual[data-phase="night"] .observatory__earth {
        background-image: url("/images/trajectory/earth-poster-v2-night.webp");
    }
    .experience-visual__destination {
        font:
            0.65rem DMMono,
            monospace;
        text-align: center;
        color: #bdcbb5;
        margin: 0.5rem 0;
        max-width: none;
    }
    .observatory__label {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
    }
    .observatory__controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.4rem;
        background: transparent;
        margin-top: -1rem;
        position: relative;
        z-index: 4;
    }
    .observatory__worlds {
        display: flex;
        gap: clamp(0.4rem, 1.8vw, 1.6rem);
        order: 2;
    }
    .observatory__actions {
        display: flex;
        gap: 0.2rem;
        order: 1;
        border-right: 1px solid #66726055;
        padding-right: 1rem;
    }
    .observatory__controls button {
        color: #d7ded7;
        font-family: DMMono, monospace;
        font-size: 0.75rem;
        padding: 0.6rem 0.15rem;
        min-height: 44px;
        border: 0;
        border-radius: 0;
        background: transparent;
    }
    .observatory__controls button[aria-pressed="true"] {
        color: #dfa05d;
        background: transparent;
        box-shadow: 0 1px #dfa05d;
    }
    .observatory__controls button:hover {
        color: #f4c58e;
        background: transparent;
    }
    .observatory__actions button {
        font-size: 0;
        min-width: 32px;
    }
    .observatory__actions button::before {
        font-size: 1rem;
        content: "Ⅱ";
    }
    .observatory__actions
        [data-experience-motion][aria-pressed="true"]::before {
        content: "▷";
    }
    .observatory__actions [data-experience-reset]::before {
        content: "↺";
        font-size: 1.35rem;
    }
    .observatory__actions [data-experience-zoom="+"]::before {
        content: "+";
    }
    .observatory__actions [data-experience-zoom="-"]::before {
        content: "−";
    }
    .observatory__status {
        font-size: 0.75rem;
        text-align: center;
        color: #c1cbbf;
    }
    .experience-visual__hint {
        font-family: DMMono, monospace;
        font-size: 0.64rem;
        letter-spacing: 0.08em;
        text-align: center;
        color: #9aa99f;
        margin: 1.3rem 0 0.4rem;
        max-width: none;
    }
    .experience-visual__hint span:last-child {
        margin-left: 1.5rem;
    }
    .experience-visual__lighting {
        color: #c8c0ad;
        text-align: center;
        font:
            0.67rem DMMono,
            monospace;
        letter-spacing: 0.06em;
        margin: 0.8rem 0 0.55rem;
        max-width: none;
    }
    .experience-visual__lighting::before {
        content: "";
        display: inline-block;
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: #dfa05d;
        margin: 0 0.6rem 0.1rem 0;
        box-shadow: 0 0 10px #dfa05d55;
    }
    .experience-visual[data-phase="night"]
        .experience-visual__lighting::before {
        background: #98b8d6;
    }
    .experience-visual__sky-credit {
        font-size: 0.65rem;
        color: #aab3b7;
        text-align: center;
        max-width: none;
        margin: 0.25rem 0 0.5rem;
    }
    .experience-visual__sky-credit a {
        color: #c6c8c1;
        text-underline-offset: 0.2em;
    }
    .experience-visual__details {
        font-size: 0.67rem;
        color: #8f9e95;
        text-align: center;
        max-width: 38rem;
        margin: auto;
    }
    .experience-visual__details summary {
        cursor: pointer;
        min-height: 32px;
    }
    .experience-visual__details p {
        margin: 0.5rem auto;
    }
    .experience-visual__details a {
        color: #c5ac89;
    }
    @media (min-width: 801px) and (max-height: 850px) {
        .observatory__viewport {
            height: max(280px, calc(100svh - 365px));
        }
        .experience-visual__hint {
            margin-top: 0.6rem;
        }
        .experience-visual__lighting {
            margin-top: 0.5rem;
        }
    }
    @media (max-width: 800px) {
        .observatory__viewport {
            height: clamp(220px, 62vw, 340px);
        }
        .observatory__paths {
            opacity: 0.18;
        }
        .observatory__controls {
            margin-top: -0.6rem;
            gap: 0.3rem;
            flex-wrap: wrap;
        }
        .observatory__worlds {
            gap: 0.1rem;
            flex-basis: 100%;
            justify-content: center;
            order: 1;
        }
        .observatory__controls button {
            font-size: 0.63rem;
            min-height: 44px;
            min-width: 44px;
        }
        .observatory__actions {
            padding-right: 0;
            gap: 0;
            border: 0;
            order: 2;
        }
        .observatory__actions button {
            font-size: 0;
            min-width: 44px;
        }
        .experience-visual__hint {
            margin: 0.4rem 0 0.1rem;
            font-size: 0.58rem;
        }
        .experience-visual__details {
            font-size: 0.6rem;
        }
        .experience-visual__details summary {
            min-height: 32px;
        }
    }
    @media (max-width: 380px) {
        .observatory__controls {
            flex-wrap: wrap;
        }
        .observatory__worlds {
            flex-basis: 100%;
            justify-content: center;
            order: 1;
        }
        .observatory__actions {
            order: 2;
            border: 0;
            padding-right: 0;
        }
    }
    @media print {
        .experience-visual {
            display: none;
        }
    }
</style>
