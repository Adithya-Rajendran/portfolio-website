---
interface Props {
    model: {
        kind: string;
        procedural?: string | null;
        fileUrl?: string | null;
        alt: string;
    };
}
const { model } = Astro.props;
---

{((model.kind === "procedural" && model.procedural === "homelab-rack") ||
    (model.kind === "gltf" && model.fileUrl)) && (
    <section
        class="project-viewer"
        data-project-viewer
        data-kind={model.kind}
        data-procedural={model.procedural}
        data-url={model.fileUrl}
    >
        <div
            class="project-viewer__stage"
            data-viewer-stage
            role="img"
            aria-label={model.alt + ". Use arrow keys to rotate."}
            aria-describedby="project-viewer-instructions"
        ></div>
        <div
            class="project-viewer__controls"
            role="group"
            aria-label="Model controls"
        >
            <button type="button" data-viewer-motion aria-pressed="false">
                Pause motion
            </button>
            <button type="button" data-viewer-closer aria-label="Zoom in">
                +
            </button>
            <button type="button" data-viewer-further aria-label="Zoom out">
                −
            </button>
            <button type="button" data-viewer-reset>
                Reset view
            </button>
        </div>
        <p id="project-viewer-instructions">
            Drag to orbit · Arrow keys to look · Scroll to keep reading
        </p>
        <p data-viewer-status role="status">
            Loading model…
        </p>
        <button
            class="project-viewer__retry"
            type="button"
            data-viewer-retry
            hidden
        >
            Try model again
        </button>
    </section>
)}
<noscript>
    <style is:inline>
        .project-viewer {
            display: none;
        }
    </style>
</noscript>
<script>
    import "../../scripts/viewer/project-viewer";
</script>
<style>
    .project-viewer {
        margin-block: 2rem;
    }
    .project-viewer__stage {
        height: clamp(300px, 55vw, 600px);
        background: #262923;
        overflow: hidden;
        touch-action: pan-y pinch-zoom;
        cursor: grab;
    }
    .project-viewer__stage[data-dragging] {
        cursor: grabbing;
    }
    .project-viewer__stage:focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: -2px;
    }
    .project-viewer__controls {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        min-height: 44px;
        margin-top: 0.5rem;
        visibility: hidden;
    }
    [data-ready] .project-viewer__controls {
        visibility: visible;
    }
    .project-viewer__controls button {
        min-width: 44px;
        min-height: 44px;
        font-size: 0.8rem;
    }
    .project-viewer p {
        text-align: center;
        max-width: none;
        font-size: 0.8rem;
        min-height: 1.5em;
        margin: 0.25rem 0;
    }
    .project-viewer__stage :global(canvas) {
        display: block;
        width: 100%;
        height: 100%;
    }
    .project-viewer__retry {
        display: block;
        margin: 0.5rem auto;
    }
    .project-viewer__retry[hidden] {
        display: none;
    }
    @media print {
        .project-viewer {
            display: none;
        }
    }
</style>
