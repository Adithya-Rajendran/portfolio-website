{
  "name": "arcadia-station",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "python3 tools/site.py --shell index.html --out public && vite",
    "build": "vite build && vite build --mode review && python3 tools/site.py --shell dist/index.html --out dist",
    "preview": "vite preview",
    "test:e2e": "node tests/e2e/run.mjs",
    "typecheck": "node tools/ci/ratchet.mjs typecheck",
    "lint": "node tools/ci/ratchet.mjs lint",
    "test": "vitest run"
  },
  "dependencies": {
    "three": "0.181.2"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.4",
    "@types/three": "0.181.0",
    "eslint-plugin-solid": "0.20.1",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
