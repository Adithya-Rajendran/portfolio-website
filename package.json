{
    "name": "adithya-rajendran.com",
    "version": "0.1.0",
    "private": true,
    "description": "Adithya Rajendran's personal website: writing, projects and the CV, on Astro, Cloudflare Workers and Sanity.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Adithya-Rajendran/portfolio-website.git"
    },
    "packageManager": "pnpm@10.34.5",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "node scripts/build-studio.mjs && astro build",
        "start": "wrangler dev --local",
        "lint": "eslint . --max-warnings 0",
        "typecheck": "astro check",
        "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css,astro}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yml,yaml,css,astro}\"",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "playwright test",
        "test:e2e:preview": "playwright test",
        "typegen": "sanity schema extract --enforce-required-fields --workspace portfolio-blog --force && sanity typegen generate",
        "schema:deploy": "sanity deploy --external --url https://adithya-rajendran.com/studio --schema-required",
        "prepare": "husky"
    },
    "lint-staged": {
        "*": "node scripts/check-project-ids.mjs",
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{js,mjs,json,md,yml,yaml,css,astro}": [
            "prettier --write"
        ]
    },
    "dependencies": {
        "@astrojs/cloudflare": "14.4.4",
        "@portabletext/to-html": "^6.0.0",
        "@sanity/client": "^8.9.0",
        "@sanity/code-input": "^7.3.12",
        "@sanity/image-url": "^2.1.1",
        "@sanity/vision": "^6.19.0",
        "astro": "7.4.5",
        "groq": "^6.22.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "sanity": "^6.19.0",
        "sharp": "^0.35.5",
        "shiki": "^4.5.0",
        "styled-components": "^6.6.0",
        "three": "^0.186.1",
        "zod": "^4.5.4"
    },
    "pnpm": {
        "overrides": {
            "js-yaml@<3.14.2": "^3.14.2",
            "js-yaml@>=4.0.0 <=4.1.1": "^4.2.0",
            "postcss@<8.5.10": "^8.5.10",
            "uuid@<11.1.1": "^11.1.1",
            "tsx>esbuild": "^0.28.1",
            "vite>esbuild": "^0.28.1",
            "form-data@>=4.0.0 <4.0.6": "^4.0.6",
            "undici@>=7.0.0 <7.29.1": "^7.29.1",
            "tar@<=7.5.15": "^7.5.16",
            "dompurify@<3.4.16": "^3.4.16",
            "@babel/core@<=7.29.0": "^7.29.6",
            "smol-toml@<1.9.0": "^1.9.0",
            "adm-zip@<0.6.1": "^0.6.1",
            "sharp@<0.35.0": "^0.35.3",
            "nanoid@<3.3.18": "^3.3.18",
            "fast-uri@<3.1.8": "^3.1.8",
            "brace-expansion@<1.1.21": "^1.1.21",
            "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12"
        }
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@axe-core/playwright": "^4.14.0",
        "@eslint/js": "^9.39.5",
        "@playwright/test": "^1.64.1",
        "@types/node": "^24.19.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.186.0",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^9.39.5",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "schema-dts": "^2.1.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5",
        "wrangler": "^4.157.0"
    }
}
